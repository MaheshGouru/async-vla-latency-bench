# Docker image for running the Days 1-3 benchmark on Modal.
# Edit the ARG values (or pass --build-arg) to pin LeRobot, robosuite, and LIBERO.
ARG CUDA_VERSION=12.1.0
FROM nvidia/cuda:${CUDA_VERSION}-cudnn8-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    MUJOCO_GL=egl \
    PYOPENGL_PLATFORM=egl

RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    gnupg \
    dirmngr \
    software-properties-common \
    build-essential \
    cmake \
    libgl1-mesa-glx \
    libgl1-mesa-dev \
    libegl1-mesa-dev \
    libglew-dev \
    libosmesa6-dev \
    libglib2.0-0 \
    patchelf \
    && add-apt-repository -y ppa:deadsnakes/ppa \
    && apt-get update && apt-get install -y --no-install-recommends \
    python3.12 \
    python3.12-dev \
    python3.12-venv \
    && rm -rf /var/lib/apt/lists/*

RUN python3.12 -m ensurepip --upgrade \
    && update-alternatives --install /usr/bin/python python /usr/bin/python3.12 1 \
    && update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.12 1 \
    && python -m pip install --upgrade pip wheel setuptools

ARG LEROBOT_COMMIT=main

# Install LeRobot with the pi0.5 and libero extras. Do NOT install `libero` or
# `robosuite` directly from their raw GitHub repos: the upstream
# Lifelong-Robot-Learning/LIBERO setup.py has a packaging bug (its top-level
# `libero` package directory has no __init__.py, so setuptools' find_packages()
# silently produces an empty wheel with no importable code) and its pinned
# robosuite/mujoco versions do not match what current robosuite@master installs.
# LeRobot's own `[libero]` extra instead depends on `hf-libero`, a properly
# packaged PyPI distribution (still imported as `libero`) with matching,
# mutually-compatible robosuite/mujoco/bddl pins baked in.
RUN python -m pip install \
    "lerobot[pi,libero] @ git+https://github.com/huggingface/lerobot.git@${LEROBOT_COMMIT}"

# libero.libero's __init__.py prompts interactively (`input()`) the first time
# it runs if ~/.libero/config.yaml does not exist yet, which hangs/fails in a
# non-interactive container. Pre-create the config at build time so every
# container starts with it already present. `import libero` (top-level) is
# safe here; only `libero.libero` triggers the prompt, and we avoid importing it.
RUN python -c "\
import libero, os, yaml; \
root = os.path.join(os.path.dirname(libero.__file__), 'libero'); \
cfg = { \
    'benchmark_root': root, \
    'bddl_files': os.path.join(root, 'bddl_files'), \
    'init_states': os.path.join(root, 'init_files'), \
    'datasets': os.path.join(root, '../datasets'), \
    'assets': os.path.join(root, 'assets'), \
}; \
os.makedirs(os.path.expanduser('~/.libero'), exist_ok=True); \
yaml.dump(cfg, open(os.path.expanduser('~/.libero/config.yaml'), 'w'))"

COPY . /root/async-vla-latency-bench
WORKDIR /root/async-vla-latency-bench
RUN python -m pip install .
